u are interested in opening a new savings account? 🤔\"\n\n        Complete Customer-Facing UI Payload:\n        \"{\"uiType\": \"blocks\", \"options\": [], \"stepDetails\": [], \"listTitle\": \"\", \"listIntro\": \"\", \"items\": [], \"extendedText\": \"\", \"listClarificationText\": \"\", \"responseBlocks\": [{\"type\": \"clarification\", \"text\": \"Could you please let me know a bit more about what you are looking for, such as whether you would like to learn more about the general services Horizon Bank offers or if you are interested in opening a new savings account? 🤔\", \"options\": [{\"label\": \"General Inquiry\", \"message\": \"I would like to know more about the services Horizon Bank offers.\"}, {\"label\": \"Product Information\", \"message\": \"I am interested in opening a new savings account.\"}]}]}\"\n        \n\n        Output JSON only:\n        {\"conduct_compliant\": true/false, \"conduct_reason\": \"...\", \"conduct_violations\": [{\"rule\": \"bank_conduct\" | \"regulation\", \"violation\": \"...\", \"unsupported_content\": [\"verbatim phrase\"]}], \"answer_compliant\": true/false, \"clarification_compliant\": true/false, \"rewrite_instruction\": \"...\", \"evidence_grounded\": true/false, \"evidence_reason\": \"...\", \"evidence_violations\": [{\"scope\": \"...\", \"unsupported_content\": [\"verbatim phrase\"], \"evidence_gap\": \"...\"}], \"answer_evidence_grounded\": true/false, \"answer_bridge_grounded\": true/false, \"clarification_grounded\": true/false, \"clarification_connected\": true/false, \"response_recovery_strategy\":\"NO_STRATEGY\" | \"REMOVE_UNSUPPORTED_CONTENT\" | \"NARROW_TO_EVIDENCE_SCOPE\" | \"CLARIFY_FROM_ALLOWED_CONTEXT\", \"grounding_violations\": [{\"task_id\": \"task_1\", \"scope\": \"answer\" | \"ui_payload\" | \"clarification\", \"audit_layer\": \"evidence\" | \"bridge\" | \"other\", \"violation_type\": \"unsupported_factual_claim\" | \"unsupported_bridge_inference\" | \"unsupported_instruction\" | \"wrong_task_evidence\"