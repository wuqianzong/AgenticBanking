g loan balance being settled in the final month.\"\n\n        Customer-Facing Clarification:\n        \"\"\n\n        Complete Customer-Facing UI Payload:\n        \"{\"uiType\": \"blocks\", \"options\": [], \"stepDetails\": [], \"listTitle\": \"\", \"listIntro\": \"\", \"items\": [], \"extendedText\": \"\", \"listClarificationText\": \"\", \"responseBlocks\": [{\"type\": \"text\", \"contextText\": \"\", \"text\": \"At Horizon Bank, the true cost of borrowing for an Instant Loan is determined using the Effective Interest Rate 🧮. This rate is calculated by taking into account the processing fee and assuming timely payment of the minimum monthly amount, with the outstanding loan balance being settled in the final month.\", \"items\": [], \"options\": [], \"progressTitle\": \"\", \"stepDetails\": [], \"currentStep\": null, \"totalSteps\": null, \"listTitle\": \"\", \"listIntro\": \"\", \"extendedText\": \"\"}]}\"\n        \n\n        Output JSON only:\n        {\"conduct_compliant\": true/false, \"conduct_reason\": \"...\", \"conduct_violations\": [{\"rule\": \"bank_conduct\" | \"regulation\", \"violation\": \"...\", \"unsupported_content\": [\"verbatim phrase\"]}], \"answer_compliant\": true/false, \"clarification_compliant\": true/false, \"rewrite_instruction\": \"...\", \"evidence_grounded\": true/false, \"evidence_reason\": \"...\", \"evidence_violations\": [{\"scope\": \"...\", \"unsupported_content\": [\"verbatim phrase\"], \"evidence_gap\": \"...\"}], \"answer_evidence_grounded\": true/false, \"answer_bridge_grounded\": true/false, \"clarification_grounded\": true/false, \"clarification_connected\": true/false, \"response_recovery_strategy\":\"NO_STRATEGY\" | \"REMOVE_UNSUPPORTED_CONTENT\" | \"NARROW_TO_EVIDENCE_SCOPE\" | \"CLARIFY_FROM_ALLOWED_CONTEXT\", \"grounding_violations\": [{\"task_id\": \"task_1\", \"scope\": \"answer\" | \"ui_payload\" | \"clarification\", \"audit_layer\": \"evidence\" | \"bridge\" | \"other\", \"violation_type\": \"unsupported_factual