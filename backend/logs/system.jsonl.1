ids\": [\"...\"], \"evidence_delta\": [{\"parent_id\": \"...\", \"fact\": \"...\"}], \"scope_expansion_lead_reason\": \"\", \"scope_expansion_lead_parent_id\": \"\", \"likely_ambiguous_request\": true|false, \"unresolved_term\": \"\", \"clarification_reason\": \"\", \"clarification_guesses\": [{\"label\": \"...\", \"message\": \"...\", \"reason\": \"...\"}]}]}\n        "}
