SS only for sequential multi-step processes.\n      * Use COMPARISON when comparing 2-3 products, rates, or account types side-by-side.\n      * Use ACCORDION when presenting multiple detailed FAQ/policy sections without cluttering chat height.\n      * Use TIMELINE when showing request/application milestone progress (past, current, future).\n      * Use CAROUSEL when showcasing multiple options, cards, or promotional perks horizontally.\n      * Use ALERT when delivering an important security notice, scam warning, or compliance caution.\n\n    Output JSON only:\n    {\"elements\":[{\"type\":\"TEXT|LIST|PROGRESS|COMPARISON|ACCORDION|TIMELINE|CAROUSEL|ALERT\",\"source_task_ids\":[\"task_1\"],\"context_text\":\"optional natural connector\",\"answer\":\"grounded prose\",\"title\":\"optional component title\",\"list_title\":\"only for LIST\",\"list_items\":[\"only for LIST\"],\"progress_title\":\"only for PROGRESS\",\"progress_steps\":[{\"title\":\"...\",\"detail\":\"...\"}],\"headers\":[\"for COMPARISON\"],\"rows\":[{\"feature\":\"...\",\"values\":[\"...\"]}],\"actions\":[{\"label\":\"...\",\"action\":\"...\"}],\"sections\":[{\"title\":\"...\",\"content\":\"...\"}],\"subtitle\":\"for TIMELINE\",\"steps\":[{\"title\":\"...\",\"description\":\"...\",\"status\":\"completed|active|pending\",\"date\":\"...\"}],\"items\":[{\"title\":\"...\",\"subtitle\":\"...\",\"badge\":\"...\",\"highlight\":\"...\",\"details\":[\"...\"],\"actionLabel\":\"...\",\"actionMessage\":\"...\"}],\"severity\":\"warning|security|info|success\",\"message\":\"for ALERT\",\"action\":{\"label\":\"...\",\"action\":\"...\"},\"extended_text\":\"optional additional grounded prose\",\"options\":[{\"label\":\"short action\",\"message\":\"complete grounded question\"}]}],\"clarification\":{\"text\":\"\",\"candidate_replies\":[{\"label\":\"short chip text\",\"message\":\"complete natural sentence\"}]}}\n    "}
