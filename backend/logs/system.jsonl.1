\":\"...\",\"tool_name\":\"...\",\"operation\":\"...\",\"input\":{},\"rag_role\":\"needed\"|\"complementary\"|\"redundant\"}], \"clarifications\":[{\"subquery_id\":\"...\",\"unresolved_request\":\"...\",\"clarification_reason\":\"...\",\"clarification_guesses\":[{\"label\":\"...\",\"message\":\"...\",\"reason\":\"...\"}]}]}\n        "}
