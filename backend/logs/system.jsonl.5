iolation_type\": \"unsupported_factual_claim\" | \"unsupported_bridge_inference\" | \"unsupported_instruction\" | \"wrong_task_evidence\" | \"unsupported_clarification_suggestion\" | \"missing_decline_reference\" | \"task_not_answered\" | \"other\", \"unsupported_content\": [\"verbatim customer-facing phrase\"], \"evidence_gap\": \"missing permitted evidence only; no proposed remedy\"}]}\n    "}
