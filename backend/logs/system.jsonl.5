t JSON only:\n    {\"evidence_grounded\": true/false, \"reason\": \"...\", \"evidence_violations\": [{\"scope\": \"...\", \"unsupported_content\": [\"verbatim phrase\"], \"evidence_gap\": \"...\"}], \"answer_evidence_grounded\": true/false, \"answer_bridge_grounded\": true/false, \"clarification_grounded\": true/false, \"clarification_connected\": true/false, \"response_recovery_strategy\":\"NO_STRATEGY\" | \"REMOVE_UNSUPPORTED_CONTENT\" | \"NARROW_TO_EVIDENCE_SCOPE\" | \"CLARIFY_FROM_ALLOWED_CONTEXT\", \"grounding_violations\": [{\"task_id\": \"task_1\", \"scope\": \"answer\" | \"ui_payload\" | \"clarification\", \"audit_layer\": \"evidence\" | \"bridge\" | \"other\", \"violation_type\": \"unsupported_factual_claim\" | \"unsupported_bridge_inference\" | \"unsupported_instruction\" | \"wrong_task_evidence\" | \"unsupported_clarification_suggestion\" | \"missing_decline_reference\" | \"task_not_answered\" | \"other\", \"unsupported_content\": [\"verbatim customer-facing phrase\"], \"evidence_gap\": \"missing permitted evidence only; no proposed remedy\"}]}\n    "}
