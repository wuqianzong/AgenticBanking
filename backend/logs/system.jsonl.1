\": \"profile-address-update\", \"description\": \"Submit a new postal address for the customer's profile.\", \"risk_level\": \"low\"}, {\"service_request_id\": \"card-replacement-request\", \"description\": \"Request a replacement physical card for a non-fraud reason (worn or damaged).\", \"risk_level\": \"low\"}, {\"service_request_id\": \"kyc-document-resubmission\", \"description\": \"Resubmit an identity document for an existing customer's KYC record.\", \"risk_level\": \"intermediate\"}]}, {\"tool_name\": \"api\", \"operations\": [\"read_customer_data\"], \"description\": \"Read one specific, verified piece of the customer's own banking data on file (e.g. their address, their loyalty tier). Use this for a request about the customer's actual personal data value, not a general policy or procedure question -- that is RAG's job.\", \"read_only\": true, \"available_fields\": [{\"field_id\": \"profile-address\", \"description\": \"The customer's current postal address on file.\", \"disclosure_mode\": \"placeholder\"}, {\"field_id\": \"loyalty-status\", \"description\": \"The customer's current loyalty program tier.\", \"disclosure_mode\": \"direct_value\"}]}, {\"tool_name\": \"deeplink\", \"operations\": [\"resolve_navigation\"], \"description\": \"Return a validated Horizon navigation destination. Use this when the customer needs to navigate to a specific screen in the app.\", \"read_only\": true, \"available_destinations\": [{\"destination_id\": \"card-management\", \"description\": \"View & Manage Card screen — freeze, replace, enable overseas usage.\", \"route\": \"/app/cards/manage\", \"label\": \"Manage Card\"}, {\"destination_id\": \"account-statements\", \"description\": \"Statements screen — view and download past monthly statements.\", \"route\": \"/app/accounts/statements\", \"label\": \"View Statements\"}, {\"destination_id\": \"profile-personal-details\", \"description\": \"Profile -> Personal Details screen — view and edit name, address, phone, email.\", \"route\": \"/app/profile/personal-details\", \"label\": \"Update Profile\"}, {\"destination_id\": \"security-settings\", \"description\": \"Profile -> Security screen — update PIN, view Horizon Key status.\", \"route\": \"/app/profile/security\", \"label\": \"Security Settings\"}, {\"destination_id\": \"pay-credit-card-bill\", \"description\": \"Pay Credit Card Bill screen — pay outstanding balance from a savings account.\", \"route\": \"/app/cards/pay\", \"label\": \"Pay Bill\"}]}]\n\n        Rules:\n        - Create only additive tasks. Never recreate a completed, unavailable,\n          or pending task.\n        - Every task must reference exactly one subquery_id from \"Subqueries\n          with a remaining gap this round\" -- never any other subquery_id.\n        - Use only an enabled tool_name and one of its listed operations.\n        - Do not create a task merely to restate, search again, or rewrite a\n          completed result. Do not invent facts, customer data, or capabilities.\n        - RAG's internal retries are not outer tool tasks. Add \"rag\" only\n          when no RAG task for that subquery has already reached a terminal\n          state.\n        - A capability's own description can scope out specific reasons or\n          situations, not just name a general topic -- match on the whole\n          description, not the nearest keyword. For example, a capability\n          described as covering card replacement \"for a non-fraud reason\n          (worn or damaged)\" does not cover a lost or stolen card, even\n          though both are \"card replacement\" in general terms.\n        - Return no task for a subquery if no registered enabled capability\n          genuinely applies to it.\n        - For every \"rag\" task, include the literal key \"rag_role\" with\n          exactly one of these values:\n          * \"needed\" -- no other registered tool covers this subquery at all.\n          * \"complementary\" -- another tool also covers this sub