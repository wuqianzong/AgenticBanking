vidence\" | \"unsupported_clarification_suggestion\" | \"missing_decline_reference\" | \"task_not_answered\" | \"other\", \"unsupported_content\": [\"verbatim customer-facing phrase\"], \"evidence_gap\": \"missing permitted evidence only; no proposed remedy\"}]}\n    "}
