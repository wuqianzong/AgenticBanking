cription\": \"Submit a new postal address for the customer's profile.\", \"risk_level\": \"low\"}, {\"service_request_id\": \"card-replacement-request\", \"description\": \"Request a replacement physical card for a non-fraud reason (worn or damaged).\", \"risk_level\": \"low\"}, {\"service_request_id\": \"kyc-document-resubmission\", \"description\": \"Resubmit an identity document for an existing customer's KYC record.\", \"risk_level\": \"intermediate\"}]}, {\"tool_name\": \"api\", \"operations\": [\"read_customer_data\"], \"description\": \"Read one specific, verified piece of the customer's own banking data on file (e.g. their address, their loyalty tier). Use this for a request about the customer's actual personal data value, not a general policy or procedure question -- that is RAG's job.\", \"read_only\": true, \"available_fields\": [{\"field_id\": \"profile-address\", \"description\": \"The customer's current postal address on file.\", \"disclosure_mode\": \"placeholder\"}, {\"field_id\": \"loyalty-status\", \"description\": \"The customer's current loyalty program tier.\", \"disclosure_mode\": \"direct_value\"}]}, {\"tool_name\": \"deeplink\", \"operations\": [\"resolve_navigation\"], \"description\": \"Return a validated Horizon navigation destination. Use this when the customer needs to navigate to a specific screen in the app.\", \"read_only\": true, \"available_destinations\": [{\"destination_id\": \"card-management\", \"description\": \"View & Manage Card screen — freeze, replace, enable overseas usage.\", \"route\": \"/app/cards/manage\", \"label\": \"Manage Card\"}, {\"destination_id\": \"account-statements\", \"description\": \"Statements screen — view and download past monthly statements.\", \"route\": \"/app/accounts/statements\", \"label\": \"View Statements\"}, {\"destination_id\": \"profile-personal-details\", \"description\": \"Profile -> Personal Details screen — view and edit name, address, phone, email.\", \"route\": \"/app/profile/personal